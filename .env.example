# Google Gemini API Configuration (Primary Vision & Embedding Provider)
GEMINI_API_KEY="your_gemini_api_key_here"

# Groq API Configuration (Alternative Fast Inference Provider for Qwen Vision)
GROQ_API_KEY="your_groq_api_key_here"

# Database Configuration (Defaults to SQLite; supports PostgreSQL)
DATABASE_URL="sqlite:///./capstone.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/multimodal_db"

# Mismatch Guard Decision Thresholds
SIMILARITY_THRESHOLD="0.50"
CONFIDENCE_THRESHOLD="0.80"
